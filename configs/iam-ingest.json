{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PorterListPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::example-pannier-packs",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["cell-a/*"]
        }
      }
    },
    {
      "Sid": "PorterPutNoDelete",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::example-pannier-packs/cell-a/*"
    }
  ]
}
